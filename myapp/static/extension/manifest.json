{
  "manifest_version": 3,
  "name": "Deepfake Detector",
  "version": "1.1",
  "description": "이미지를 Flask API로 보내 딥페이크 여부를 확인합니다.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}

